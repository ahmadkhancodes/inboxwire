# Copy to .env.local for dev. Never commit real values. Missing keys = stub mode.
APP_NAME=inboxwire
NEXT_PUBLIC_APP_URL=http://localhost:3000
# memory | mongo (defaults to mongo when MONGODB_URI is set)
DB_DRIVER=memory
MONGODB_URI=
MONGODB_DB=inboxwire
# >= 32 random chars, unique per app: openssl rand -base64 32
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# console | resend | smtp
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=
ALTCHA_HMAC_KEY=
# JSON of remote flags, e.g. {"payments_enabled":"on"}
APP_FLAGS=
# comma separated founder admin emails
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# M2: base64 of 32 random bytes (openssl rand -base64 32). Wraps per-org data keys that encrypt mailbox credentials. Required in production.
MASTER_KEY=

# M4: cloud only. Ed25519 PKCS8 PEM that signs self-host licences (\n escapes allowed). Never ship it in an image.
LICENCE_SIGNING_KEY=
# Public half (optional: derived from the signing key when that is set). Self-host images ship it as /app/licence-public.pem.
LICENCE_PUBLIC_KEY=
# Self-host: the licence key from Billing. Verified offline at start and on every plan check.
INBOXWIRE_LICENCE=
# Bearer token for GET /metrics. With none set, /metrics is closed (404) in production.
METRICS_TOKEN=
# Self-host only: allow IMAP/SMTP hosts and webhook URLs on private networks (default: refused, SSRF guard)
ALLOW_PRIVATE_NETWORK_TARGETS=
